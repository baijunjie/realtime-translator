{
  "name": "@rt/macos",
  "version": "0.0.0",
  "description": "Local, real-time speech transcription & translation for macOS",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "clean": "bash scripts/clean.sh",
    "clean:models": "bash scripts/clean.sh --models",
    "clean:settings": "bash scripts/clean.sh --settings",
    "clean:all": "bash scripts/clean.sh --all",
    "test-pipeline": "node scripts/build-test.mjs test/pipeline.ts && node dist-test/test/pipeline.js",
    "eval-cer": "node scripts/build-test.mjs test/eval-cer.ts && node dist-test/test/eval-cer.js",
    "eval-cer-ja": "node scripts/fetch-fleurs-eval.mjs --verify-only && node scripts/build-test.mjs test/eval-cer.ts && node dist-test/test/eval-cer.js --cases test-audio/eval/fleurs-ja-test --language ja",
    "eval-cer-ja:gate": "node scripts/fetch-fleurs-eval.mjs --verify-only && node scripts/build-test.mjs test/eval-cer.ts && node dist-test/test/eval-cer.js --cases test-audio/eval/fleurs-ja-test --models sense-voice --language ja --max-cer 20 --max-drift 5",
    "fetch-eval-fleurs": "node --max-old-space-size=2048 scripts/fetch-fleurs-eval.mjs",
    "test-eval-corpus": "node --test scripts/fleurs-eval-lib.test.mjs",
    "test-translate": "node scripts/build-test.mjs test/translate.ts && node dist-test/test/translate.js",
    "icons": "node scripts/gen-icon.mjs",
    "dist": "node scripts/package-mac.mjs",
    "dist:dir": "node scripts/package-mac.mjs --dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "chinese-conv": "catalog:",
    "sherpa-onnx-node": "^1.13.2"
  },
  "devDependencies": {
    "@lucide/vue": "catalog:",
    "@rt/core": "workspace:*",
    "@rt/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "naive-ui": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-tsc": "catalog:"
  }
}
